---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import enTranslations from '../i18n/en.json';
import esTranslations from '../i18n/es.json';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Languages from '../components/Languages.astro';
import Footer from '../components/Footer.astro';
import '../styles/portfolio.css';

const { lang = 'en' } = Astro.props as { lang: 'en' | 'es' };

const experience = await getCollection('experience', ({ id }: { id: string }) =>
  id.startsWith(`${lang}/`)
);
const skills = await getCollection('skills', ({ id }: { id: string }) =>
  id.startsWith(`${lang}/`)
);
const education = await getCollection('education', ({ id }: { id: string }) =>
  id.startsWith(`${lang}/`)
);
const highlights = await getCollection('highlights', ({ id }: { id: string }) =>
  id.startsWith(`${lang}/`)
);

const expOrdered = experience.sort((a: CollectionEntry<'experience'>, b: CollectionEntry<'experience'>) => a.data.order - b.data.order);
const skillsOrdered = skills.sort((a: CollectionEntry<'skills'>, b: CollectionEntry<'skills'>) => a.data.order - b.data.order);
const educationOrdered = education.sort((a: CollectionEntry<'education'>, b: CollectionEntry<'education'>) => a.data.order - b.data.order);
const highlightsOrdered = highlights.sort((a: CollectionEntry<'highlights'>, b: CollectionEntry<'highlights'>) => a.data.order - b.data.order);

const otherLang = lang === 'en' ? 'es' : 'en';
const otherUrl  = lang === 'en' ? '/es' : '/';
const currentYear = new Date().getFullYear();
const siteUrl = lang === 'en' ? 'https://famarin.dev/' : 'https://famarin.dev/es';

const ui = {
  en: enTranslations,
  es: esTranslations,
};

const t = ui[lang];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{t.metaTitle}</title>
  <meta name="description" content={t.metaDescription} />
  <meta name="theme-color" content="#0c0a08" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:title" content={t.metaTitle} />
  <meta property="og:description" content={t.metaDescription} />
  <meta property="og:image" content="https://famarin.dev/og-image.png" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CO'} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={siteUrl} />
  <meta name="twitter:title" content={t.metaTitle} />
  <meta name="twitter:description" content={t.metaDescription} />
  <meta name="twitter:image" content="https://famarin.dev/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Press+Start+2P&display=swap" rel="stylesheet"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-0LFTER7DSJ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0LFTER7DSJ');
  </script>
</head>
<body>

  <Nav translations={t} otherLang={otherLang} otherUrl={otherUrl} />

  <Hero translations={t} />

  <Skills skills={skillsOrdered} translations={t} />

  <Experience experience={expOrdered} translations={t} />

  <Highlights highlights={highlightsOrdered} translations={t} />

  <div class="bottom-section" id="education">
    <Education education={educationOrdered} translations={t} />
    <Languages translations={t} />
  </div>

  <Footer translations={t} currentYear={currentYear} />

  <script is:inline>
    let scrollTracked = {
      '25': false,
      '50': false,
      '75': false,
      '100': false
    };

    window.addEventListener('scroll', function() {
      const winHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const scrollPercent = (scrollTop / (docHeight - winHeight)) * 100;

      ['25', '50', '75', '100'].forEach(function(milestone) {
        if (scrollPercent >= parseInt(milestone) && !scrollTracked[milestone]) {
          scrollTracked[milestone] = true;
          if (typeof gtag !== 'undefined') {
            gtag('event', 'scroll_depth', {
              'event_category': 'engagement',
              'event_label': milestone + '%',
              'value': parseInt(milestone)
            });
          }
        }
      });
    });

    document.addEventListener('DOMContentLoaded', function() {
      const resumeLinks = document.querySelectorAll('a[href="/resume.pdf"]');
      resumeLinks.forEach(function(link) {
        link.addEventListener('click', function() {
          if (typeof gtag !== 'undefined') {
            gtag('event', 'resume_download', {
              'event_category': 'engagement',
              'event_label': 'Resume PDF',
              'transport_type': 'beacon'
            });
          }
        });
      });
    });
  </script>

</body>
</html>
